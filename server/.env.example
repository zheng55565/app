# ===== 基础服务 =====
PORT=3000
BASE_URL=http://localhost:3000

# ===== 数据库（PostgreSQL）=====
DATABASE_URL=postgres://postgres:postgres@localhost:5432/linuxdo_ad_reward

# ===== JWT =====
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d

# ===== LinuxDo Connect OAuth2 =====
# 在 https://connect.linux.do/dash/sso 申请接入，获得 Client Id / Client Secret
# 回调地址填写: {BASE_URL}/api/linuxdo/bind/callback
LINUXDO_CLIENT_ID=
LINUXDO_CLIENT_SECRET=
LINUXDO_REDIRECT_URI=http://localhost:3000/api/linuxdo/bind/callback
# 绑定要求的最低信任等级（0-4），0 表示不限制
LINUXDO_MIN_TRUST_LEVEL=1

# ===== 广告平台 =====
# 广告平台服务端回调签名密钥（以实际接入的广告平台文档为准）
AD_CALLBACK_SECRET=change-me
# 每日最大广告次数 / 每次奖励金额（管理后台可覆盖，这里是默认值）
AD_DAILY_MAX=6
AD_REWARD_AMOUNT=0.100000
# 广告任务过期时间（分钟）
AD_TASK_EXPIRE_MINUTES=10

# ===== 广告位（下发给 App 的 ad-config，改环境变量即可远程调整，无需发版）=====
# provider: mock | hj（HJ 聚合 SDK）| pangle | ylh | admob ...
AD_PROVIDER=mock
# HJ 聚合 SDK 的 App Id（provider=hj 时必填）
AD_HJ_APP_ID=
AD_SPLASH_ENABLED=false
AD_REWARDED_ENABLED=true
# 小游戏补救广告（复活/续时/提示等本局功能，绝不发奖到钱包）
AD_GAME_REWARDED_ENABLED=true
AD_INTERSTITIAL_ENABLED=false
AD_UNIT_SPLASH=splash_001
# 首页余额广告位：走 task_token + 服务端回调发奖，计入每日次数
AD_UNIT_REWARDED_HOME=reward_video_001
# 小游戏补救广告位：只回传本局结果，永不进钱包发奖逻辑
AD_UNIT_REWARDED_GAME=reward_game_001
AD_UNIT_INTERSTITIAL=interstitial_001
# 频控（秒/次）
AD_INTERSTITIAL_COOLDOWN_SEC=180
AD_INTERSTITIAL_DAILY_MAX=0
AD_SPLASH_MIN_INTERVAL_SEC=300
