# ===== 基础服务 =====
PORT=3001
HOST=127.0.0.1
BASE_URL=http://localhost:3001
TRUST_PROXY_HOPS=0
JSON_BODY_LIMIT=2mb
APP_NAME=AI 公益工作台
GAME_CLIENT_LOG_ENABLED=true

# ===== 数据库（PostgreSQL）=====
DATABASE_URL=postgres://postgres:postgres@localhost:5432/linuxdo_ad_reward
DB_TIMEZONE=Asia/Shanghai
DB_POOL_MAX=20

# ===== JWT =====
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d
RISK_HASH_SECRET=change-me-to-another-long-random-string

# ===== 独立管理后台（默认关闭）=====
# 生成密码哈希：node -e "require('bcryptjs').hash(process.argv[1], 12).then(console.log)" "你的密码"
ADMIN_AUTH_ENABLED=false
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=
ADMIN_JWT_SECRET=change-me-to-an-independent-long-random-string
ADMIN_JWT_EXPIRES_IN=8h

# 仅用于本机真实广告联调；还必须同时满足 NODE_ENV!=production 与 STATION_MODE=mock。
PREVIEW_AUTH_ENABLED=false
PREVIEW_AUTH_USERNAME=preview_user
PREVIEW_AUTH_PASSWORD=replace-with-a-local-test-password

# ===== LinuxDo Connect OAuth2 =====
# 在 https://connect.linux.do/dash/sso 申请接入，获得 Client Id / Client Secret
# 回调地址填写: {BASE_URL}/api/linuxdo/bind/callback
LINUXDO_CLIENT_ID=
LINUXDO_CLIENT_SECRET=
LINUXDO_REDIRECT_URI=http://localhost:3001/api/linuxdo/bind/callback
# 绑定要求的最低信任等级（0-4），0 表示不限制
LINUXDO_MIN_TRUST_LEVEL=1

# ===== 广告平台 =====
# HJ 广告位后台的 Security Key；服务端按 SHA-256(SecurityKey:trans_id) 校验
# 回调 URL 模板:
# https://API域名/api/ad-callback/hj/reward?userId={{USER_ID}}&rewardAmount={{REWARD_AMOUNT}}&rewardName={{REWARD_NAME}}&transId={{TRANS_ID}}&sign={{SIGN}}&extrainfo={{EXTRAINFO}}&placementId={{PLACEMENT_ID}}
AD_CALLBACK_SECRET=change-me
# 每日最大广告次数 / 每次奖励金额（管理后台可覆盖，这里是默认值）
AD_DAILY_MAX=6
AD_REWARD_AMOUNT=0.020000
AD_DAILY_REWARD_MICROUNITS_MAX=120000
AD_DAILY_MAX_PER_DEVICE=6
AD_DAILY_MAX_PER_IP=30
AD_MAX_PENDING_PER_DEVICE=2
AD_DAILY_REWARD_MICROUNITS_PER_DEVICE_MAX=120000
AD_DAILY_REWARD_MICROUNITS_PER_IP_MAX=600000
AD_BUSINESS_TIMEZONE=Asia/Shanghai
REQUIRE_INSTALL_ID=true
# 广告任务过期时间（分钟）
AD_TASK_EXPIRE_MINUTES=10
AD_TASK_START_COOLDOWN_SEC=5
AD_MAX_PENDING_PER_USER=2
AD_REQUIRE_TRANSACTION_ID=true

# ===== 广告位（下发给 App 的 ad-config，改环境变量即可远程调整，无需发版）=====
# provider: mock | hj（HJ 聚合 SDK）| pangle | ylh | admob ...
AD_PROVIDER=mock
AD_DEV_SIMULATE=true
# HJ 聚合 SDK 的 App Id（provider=hj 时必填）
AD_HJ_APP_ID=
AD_SPLASH_ENABLED=false
AD_REWARDED_ENABLED=true
# 小游戏补救广告（复活/续时/提示等本局功能，绝不发奖到钱包）
AD_GAME_REWARDED_ENABLED=true
AD_INTERSTITIAL_ENABLED=false
AD_UNIT_SPLASH=splash_001
# 首页余额广告位：走 task_token + 服务端回调发奖，计入每日次数
AD_UNIT_REWARDED_HOME=reward_video_001
# 小游戏补救广告位：只回传本局结果，永不进钱包发奖逻辑
AD_UNIT_REWARDED_GAME=reward_game_001
AD_UNIT_INTERSTITIAL=interstitial_001
# 频控（秒/次）
AD_INTERSTITIAL_COOLDOWN_SEC=600
AD_INTERSTITIAL_DAILY_MAX=2
AD_SPLASH_MIN_INTERVAL_SEC=43200
AD_SPLASH_DAILY_MAX=1

# Web 管理端/网页端插屏素材；未配置图片和跳转地址时显示本站公益宣传卡片。
WEB_INTERSTITIAL_ENABLED=false
WEB_INTERSTITIAL_CREATIVE_ID=house-ai-workbench-v1
WEB_INTERSTITIAL_TITLE=AI 公益工作台
WEB_INTERSTITIAL_BODY=工作台、生图和趣味游戏均可使用本站额度。
WEB_INTERSTITIAL_MEDIA_URL=
WEB_INTERSTITIAL_CLICK_URL=
WEB_INTERSTITIAL_COOLDOWN_SEC=60

# ===== AI工作台 / 生图代理 =====
# App永远只请求本服务；该地址不下发给App。填写OpenAI兼容站点根地址（不要带 /v1）。
AI_ENABLED=true
AI_UPSTREAM_BASE_URL=http://127.0.0.1:3002
# 用户的网站 API Key 仅保存在手机安全存储，每次调用由本服务透传给 New API。
AI_ALLOW_USER_API_KEY=true
AI_SHARED_API_KEY=
AI_MAX_CONCURRENT=100
AI_MAX_CONCURRENT_PER_USER=3
AI_REQUEST_TIMEOUT_MS=300000
AI_MAX_PROMPT_CHARS=120000
AI_MAX_OUTPUT_TOKENS=16384
# 生图白名单，必须与New API /v1/models返回的模型ID一致；留空时关闭生图
AI_IMAGE_MODELS=
AI_CREDENTIAL_SYNC_ENABLED=true
# 生产必须使用至少32字符随机值，建议：openssl rand -base64 32
AI_CREDENTIAL_ENCRYPTION_KEY=dev-only-change-me-at-least-32-chars
AI_DOCUMENTS_ENABLED=true
AI_DOCUMENT_OUTPUT_DIR=var/documents
AI_DOCUMENT_WORKERS=2
AI_DOCUMENT_MAX_ACTIVE_PER_USER=2
AI_DOCUMENT_RETENTION_HOURS=72
AI_DOCUMENT_MAX_SLIDES=15
AI_DOCUMENT_MAX_SECTIONS=20
AI_DOCUMENT_MAX_IMAGES=4
AI_DOCUMENT_MAX_IMAGE_MB=8
AI_DOCUMENT_MAX_ARTIFACT_MB=50

# ===== New API / 中转站管理链路 =====
STATION_MODE=mock
STATION_BASE_URL=
# 用户在“我的”页面看到的 NewAPI 公网地址，不要填写 Docker 内网地址。
STATION_PUBLIC_BASE_URL=
STATION_ADMIN_TOKEN=
STATION_ADMIN_ID=1
STATION_QUOTA_PER_CNY=70000
STATION_QUOTA_PER_USD=500000
