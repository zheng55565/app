# Production configuration example. Copy to .env and replace every placeholder.
PORT=3100
BASE_URL=https://api.example.com

DATABASE_URL=postgres://app_user:CHANGE_ME@127.0.0.1:5432/app_database

JWT_SECRET=CHANGE_ME_WITH_A_LONG_RANDOM_VALUE
JWT_EXPIRES_IN=7d

LINUXDO_CLIENT_ID=YOUR_LINUXDO_CLIENT_ID
LINUXDO_CLIENT_SECRET=YOUR_LINUXDO_CLIENT_SECRET
LINUXDO_REDIRECT_URI=https://api.example.com/api/linuxdo/bind/callback
LINUXDO_REDIRECT_URI_V2=https://api.example.com/api/linuxdo/bind/callback
LINUXDO_MIN_TRUST_LEVEL=1

AD_CALLBACK_SECRET=CHANGE_ME_WITH_A_LONG_RANDOM_VALUE
AD_DAILY_MAX=6
AD_REWARD_MICROUNITS=100000
AD_TASK_EXPIRE_MINUTES=10
AD_PROVIDER=mock
AD_HJ_APP_ID=YOUR_AD_APP_ID
AD_UNIT_SPLASH=YOUR_SPLASH_UNIT_ID
AD_UNIT_INTERSTITIAL=YOUR_INTERSTITIAL_UNIT_ID
AD_UNIT_REWARDED_HOME=YOUR_HOME_REWARDED_UNIT_ID
AD_UNIT_REWARDED_GAME=YOUR_GAME_REWARDED_UNIT_ID
AD_SPLASH_ENABLED=false
AD_REWARDED_ENABLED=true
AD_GAME_REWARDED_ENABLED=true
AD_INTERSTITIAL_ENABLED=false

STATION_MODE=newapi
STATION_BASE_URL=https://station.example.com
STATION_ADMIN_TOKEN=YOUR_STATION_ADMIN_TOKEN
STATION_ADMIN_ID=YOUR_STATION_ADMIN_ID
STATION_QUOTA_PER_CNY=25000000

ALLOW_PASSWORD_REGISTER=false
ACCESS_TOKEN_TTL_SEC=900
REFRESH_TOKEN_TTL_DAYS=30
LOGIN_CODE_TTL_SEC=240

APP_LINK_ANDROID=
APP_LINK_IOS_SCHEME=gongyiapp
