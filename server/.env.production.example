# Production configuration example. Copy to .env and replace every placeholder.
PORT=3001
HOST=127.0.0.1
BASE_URL=https://api.example.com
TRUST_PROXY_HOPS=1
JSON_BODY_LIMIT=2mb
APP_NAME=AI 公益工作台
GAME_CLIENT_LOG_ENABLED=false

DATABASE_URL=postgres://app_user:CHANGE_ME@127.0.0.1:5432/app_database
DB_TIMEZONE=Asia/Shanghai
DB_POOL_MAX=20

JWT_SECRET=CHANGE_ME_WITH_A_LONG_RANDOM_VALUE
JWT_EXPIRES_IN=7d
RISK_HASH_SECRET=CHANGE_ME_WITH_A_DIFFERENT_LONG_RANDOM_VALUE
PREVIEW_AUTH_ENABLED=false

ADMIN_AUTH_ENABLED=true
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=__BCRYPT_HASH_ONLY__
ADMIN_JWT_SECRET=CHANGE_ME_WITH_AN_INDEPENDENT_LONG_RANDOM_VALUE
ADMIN_JWT_EXPIRES_IN=8h

LINUXDO_CLIENT_ID=YOUR_LINUXDO_CLIENT_ID
LINUXDO_CLIENT_SECRET=YOUR_LINUXDO_CLIENT_SECRET
LINUXDO_REDIRECT_URI=https://api.example.com/api/linuxdo/bind/callback
LINUXDO_REDIRECT_URI_V2=https://api.example.com/api/linuxdo/bind/callback
LINUXDO_MIN_TRUST_LEVEL=1

# 填写 HJ 激励广告位后台生成的 Security Key，不要提交真实值
# 回调 URL 使用 /api/ad-callback/hj/reward，并带齐 USER_ID、TRANS_ID、SIGN、
# EXTRAINFO、PLACEMENT_ID、REWARD_AMOUNT、REWARD_NAME 宏。
AD_CALLBACK_SECRET=CHANGE_ME_WITH_A_LONG_RANDOM_VALUE
AD_DAILY_MAX=6
AD_REWARD_MICROUNITS=20000
AD_DAILY_REWARD_MICROUNITS_MAX=120000
AD_DAILY_MAX_PER_DEVICE=6
AD_DAILY_MAX_PER_IP=30
AD_MAX_PENDING_PER_DEVICE=2
AD_DAILY_REWARD_MICROUNITS_PER_DEVICE_MAX=120000
AD_DAILY_REWARD_MICROUNITS_PER_IP_MAX=600000
AD_BUSINESS_TIMEZONE=Asia/Shanghai
REQUIRE_INSTALL_ID=true
AD_TASK_EXPIRE_MINUTES=10
AD_TASK_START_COOLDOWN_SEC=5
AD_MAX_PENDING_PER_USER=2
AD_REQUIRE_TRANSACTION_ID=true
AD_PROVIDER=disabled
AD_DEV_SIMULATE=false
AD_HJ_APP_ID=YOUR_AD_APP_ID
AD_UNIT_SPLASH=YOUR_SPLASH_UNIT_ID
AD_UNIT_INTERSTITIAL=YOUR_INTERSTITIAL_UNIT_ID
AD_UNIT_REWARDED_HOME=YOUR_HOME_REWARDED_UNIT_ID
AD_UNIT_REWARDED_GAME=YOUR_GAME_REWARDED_UNIT_ID
AD_SPLASH_ENABLED=false
AD_REWARDED_ENABLED=false
AD_GAME_REWARDED_ENABLED=false
AD_INTERSTITIAL_ENABLED=false
AD_INTERSTITIAL_COOLDOWN_SEC=600
AD_INTERSTITIAL_DAILY_MAX=2
AD_SPLASH_MIN_INTERVAL_SEC=43200
AD_SPLASH_DAILY_MAX=1

WEB_INTERSTITIAL_ENABLED=true
WEB_INTERSTITIAL_CREATIVE_ID=house-ai-workbench-v1
WEB_INTERSTITIAL_TITLE=AI 公益工作台
WEB_INTERSTITIAL_BODY=工作台、生图和趣味游戏均可使用本站额度。
WEB_INTERSTITIAL_MEDIA_URL=https://static.example.com/interstitial.webp
WEB_INTERSTITIAL_CLICK_URL=https://example.com
WEB_INTERSTITIAL_COOLDOWN_SEC=60

STATION_MODE=newapi
STATION_BASE_URL=https://station.example.com
STATION_PUBLIC_BASE_URL=https://station.example.com
STATION_ADMIN_TOKEN=YOUR_STATION_ADMIN_TOKEN
STATION_ADMIN_ID=YOUR_STATION_ADMIN_ID
STATION_QUOTA_PER_CNY=70000
STATION_QUOTA_PER_USD=500000

AI_ENABLED=true
AI_UPSTREAM_BASE_URL=https://station.example.com
AI_ALLOW_USER_API_KEY=true
AI_SHARED_API_KEY=
AI_MAX_CONCURRENT=100
AI_MAX_CONCURRENT_PER_USER=3
AI_REQUEST_TIMEOUT_MS=300000
AI_MAX_PROMPT_CHARS=120000
AI_MAX_OUTPUT_TOKENS=16384
# 生图白名单，逗号分隔；留空时App生图功能不可用
AI_IMAGE_MODELS=
AI_CREDENTIAL_SYNC_ENABLED=true
AI_CREDENTIAL_ENCRYPTION_KEY=__GENERATE_WITH_OPENSSL_RAND_BASE64_32__
AI_DOCUMENTS_ENABLED=true
AI_DOCUMENT_OUTPUT_DIR=var/documents
AI_DOCUMENT_WORKERS=2
AI_DOCUMENT_MAX_ACTIVE_PER_USER=2
AI_DOCUMENT_RETENTION_HOURS=72
AI_DOCUMENT_MAX_SLIDES=15
AI_DOCUMENT_MAX_SECTIONS=20
AI_DOCUMENT_MAX_IMAGES=4
AI_DOCUMENT_MAX_IMAGE_MB=8
AI_DOCUMENT_MAX_ARTIFACT_MB=50
ALLOW_PASSWORD_REGISTER=false
ACCESS_TOKEN_TTL_SEC=900
REFRESH_TOKEN_TTL_DAYS=30
LOGIN_CODE_TTL_SEC=240

APP_LINK_ANDROID=
APP_LINK_IOS_SCHEME=gongyiapp
